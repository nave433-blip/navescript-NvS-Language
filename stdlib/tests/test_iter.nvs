// Tests for stdlib/iter.nvs. Run from the repo root:
//   nvs stdlib/tests/test_iter.nvs
import "../iter.nvs"

let failures = 0
fn check(name, cond) {
  if (!cond) {
    print "FAIL: " + name
    failures = failures + 1
  }
}

check("chain", deep_equal(iter_chain([1, 2], [3, 4]), [1, 2, 3, 4]))
check("chain empty", deep_equal(iter_chain([], [1]), [1]))
check("chain no-descend", deep_equal(iter_chain([[1]], [[2]]), [[1], [2]]))

check("zip_longest", deep_equal(iter_zip_longest([1, 2, 3], ["a"], 0), [[1, "a"], [2, 0], [3, 0]]))
check("zip_longest equal", deep_equal(iter_zip_longest([1], [2], 9), [[1, 2]]))
check("zip_longest empty", deep_equal(iter_zip_longest([], [], 9), []))

check("take_while", deep_equal(iter_take_while([1, 2, 3, 1], fn(x) { return x < 3 }), [1, 2]))
check("take_while none", deep_equal(iter_take_while([5], fn(x) { return x < 3 }), []))
check("drop_while", deep_equal(iter_drop_while([1, 2, 3, 1], fn(x) { return x < 3 }), [3, 1]))
check("drop_while all", deep_equal(iter_drop_while([1, 2], fn(x) { return x < 9 }), []))

check("pairwise", deep_equal(iter_pairwise([1, 2, 3, 4]), [[1, 2], [2, 3], [3, 4]]))
check("pairwise short", deep_equal(iter_pairwise([1]), []))
check("pairwise empty", deep_equal(iter_pairwise([]), []))

check("cycle", deep_equal(iter_cycle([1, 2], 3), [1, 2, 1, 2, 1, 2]))
check("cycle zero", deep_equal(iter_cycle([1, 2], 0), []))

check("repeat_n", deep_equal(iter_repeat_n("x", 3), ["x", "x", "x"]))
check("repeat_n zero", deep_equal(iter_repeat_n("x", 0), []))

check("accumulate", deep_equal(iter_accumulate([1, 2, 3, 4], fn(a, b) { return a + b }), [1, 3, 6, 10]))
check("accumulate single", deep_equal(iter_accumulate([5], fn(a, b) { return a + b }), [5]))
check("accumulate empty", deep_equal(iter_accumulate([], fn(a, b) { return a + b }), []))

check("flatten1", deep_equal(iter_flatten1([[1, 2], [3], 4]), [1, 2, 3, 4]))
check("flatten1 no-descend", deep_equal(iter_flatten1([[[1]]]), [[1]]))

check("flat_map", deep_equal(iter_flat_map([1, 2, 3], fn(x) { return [x, x * 10] }), [1, 10, 2, 20, 3, 30]))
check("flat_map scalar", deep_equal(iter_flat_map([1, 2], fn(x) { return x * 2 }), [2, 4]))

check("find_index", iter_find_index([10, 20, 30], fn(x) { return x > 15 }) == 1)
check("find_index missing", iter_find_index([10, 20], fn(x) { return x > 99 }) == -1)
check("find_index first", iter_find_index([5, 5], fn(x) { return x == 5 }) == 0)

let parts = iter_partition([1, 2, 3, 4, 5], fn(x) { return x % 2 == 0 })
check("partition", deep_equal(parts, [[2, 4], [1, 3, 5]]))

check("interleave", deep_equal(iter_interleave([1, 2, 3], ["a", "b"]), [1, "a", 2, "b", 3]))
check("interleave empty", deep_equal(iter_interleave([], [1]), [1]))

if (failures > 0) { throw "test_iter failures: " + str(failures) }
print "PASS: test_iter"
