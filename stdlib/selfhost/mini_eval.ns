// mini_eval.ns — NvS interprets a tiny subset of NvS (self-hosting step 1)
// Supported: integers, + - * / ( ), let x = expr, print expr, if (cond) { ... }

fn is_digit(c) {
  return c >= "0" and c <= "9"
}

fn is_alpha(c) {
  return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
}

fn tokenize(src) {
  let tokens = []
  let i = 0
  let n = len(src)
  while (i < n) {
    let c = src[i]
    if (c == " " or c == "\t" or c == "\n" or c == "\r") {
      i = i + 1
    } else if (is_digit(c)) {
      let j = i
      while (j < n and is_digit(src[j])) { j = j + 1 }
      tokens = push(tokens, {"t": "INT", "v": src[i:j]})
      i = j
    } else if (is_alpha(c)) {
      let j = i
      while (j < n and (is_alpha(src[j]) or is_digit(src[j]))) { j = j + 1 }
      let word = src[i:j]
      let tt = "IDENT"
      if (word == "let" or word == "print" or word == "if" or word == "else" or word == "fn" or word == "return") {
        tt = "KW"
      }
      tokens = push(tokens, {"t": tt, "v": word})
      i = j
    } else if (c == "\"" or c == "'") {
      let q = c
      let j = i + 1
      while (j < n and src[j] != q) { j = j + 1 }
      tokens = push(tokens, {"t": "STR", "v": src[(i+1):j]})
      i = j + 1
    } else {
      let two = ""
      if (i + 1 < n) { two = src[i:(i+2)] }
      if (two == "==" or two == "!=" or two == "<=" or two == ">=") {
        tokens = push(tokens, {"t": "OP", "v": two})
        i = i + 2
      } else {
        tokens = push(tokens, {"t": "OP", "v": c})
        i = i + 1
      }
    }
  }
  tokens = push(tokens, {"t": "EOF", "v": ""})
  return tokens
}

// Recursive-descent style evaluator over token array + environment map
fn mini_eval(src) {
  let tokens = tokenize(src)
  let env = {}
  let pos = 0

  fn peek() { return tokens[pos] }
  fn advance() { pos = pos + 1; return tokens[pos - 1] }
  fn match_op(v) {
    let t = peek()
    if (t["t"] == "OP" and t["v"] == v) { advance(); return true }
    return false
  }
  fn match_kw(v) {
    let t = peek()
    if (t["t"] == "KW" and t["v"] == v) { advance(); return true }
    return false
  }

  fn parse_primary() {
    let t = peek()
    if (t["t"] == "INT") {
      advance()
      return int(t["v"])
    }
    if (t["t"] == "STR") {
      advance()
      return t["v"]
    }
    if (t["t"] == "IDENT") {
      advance()
      let name = t["v"]
      // env lookup
      if (has(env, name)) { return env[name] }
      return null
    }
    if (match_op("(")) {
      let v = parse_expr()
      match_op(")")
      return v
    }
    return null
  }

  fn parse_unary() {
    if (match_op("-")) {
      return 0 - parse_unary()
    }
    if (match_op("!")) {
      let v = parse_unary()
      return !v
    }
    return parse_primary()
  }

  fn parse_mul() {
    let left = parse_unary()
    while (true) {
      if (match_op("*")) { left = left * parse_unary() }
      else if (match_op("/")) { left = left / parse_unary() }
      else if (match_op("%")) { left = left % parse_unary() }
      else { break }
    }
    return left
  }

  fn parse_add() {
    let left = parse_mul()
    while (true) {
      if (match_op("+")) { left = left + parse_mul() }
      else if (match_op("-")) { left = left - parse_mul() }
      else { break }
    }
    return left
  }

  fn parse_cmp() {
    let left = parse_add()
    if (match_op("==")) { return left == parse_add() }
    if (match_op("!=")) { return left != parse_add() }
    if (match_op("<")) { return left < parse_add() }
    if (match_op(">")) { return left > parse_add() }
    if (match_op("<=")) { return left <= parse_add() }
    if (match_op(">=")) { return left >= parse_add() }
    return left
  }

  fn parse_expr() { return parse_cmp() }

  fn parse_stmt() {
    if (match_kw("let")) {
      let t = advance()
      let name = t["v"]
      match_op("=")
      let val = parse_expr()
      env[name] = val
      return val
    }
    if (match_kw("print")) {
      let val = parse_expr()
      print val
      return val
    }
    if (match_kw("if")) {
      match_op("(")
      let cond = parse_expr()
      match_op(")")
      match_op("{")
      if (cond) {
        while (!(peek()["t"] == "OP" and peek()["v"] == "}")) {
          parse_stmt()
        }
      } else {
        // skip until }
        let depth = 1
        while (depth > 0 and peek()["t"] != "EOF") {
          let t = advance()
          if (t["t"] == "OP" and t["v"] == "{") { depth = depth + 1 }
          if (t["t"] == "OP" and t["v"] == "}") { depth = depth - 1 }
        }
        return null
      }
      match_op("}")
      return null
    }
    // expression statement
    return parse_expr()
  }

  let last = null
  while (peek()["t"] != "EOF") {
    last = parse_stmt()
  }
  return last
}

print "mini_eval loaded"
