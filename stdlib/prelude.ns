// NvS standard prelude (auto-loaded)
// Core helpers expressed in NvS itself.

fn assert(cond, msg) {
  if (!cond) {
    throw msg ?? "assertion failed"
  }
  return true
}

fn identity(x) { return x }

// NOTE (wave 2): compose lives in the interpreter now as a variadic builtin
// compose(f, g) / compose(f, g, h) -> f(g(h(x))), right-to-left like
// Haskell's (.). It also accepts partials and curried functions. The old
// two-arg NvS-level definition was removed so it can't shadow the builtin.

fn range_list(n) {
  let out = []
  for (let i = 0; i < n; i = i + 1) {
    out = push(out, i)
  }
  return out
}
