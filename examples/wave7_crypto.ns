// Wave 7: crypto/hashing + url-safe base64.
// md5 and sha1 are FINGERPRINTING hashes, not security primitives:
// fine for checksums and cache keys, never for passwords.
print sha1("abc")      // a9993e364706816aba3e25717850c26c9cd0d89d
print sha256("abc")    // (pre-existing) ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
print hmac_sha256("key", "The quick brown fox jumps over the lazy dog")
// f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8

let enc = base64url_encode("hello?+/=")
print enc                       // URL-safe: no + / or = padding
print base64url_decode(enc) == "hello?+/="   // true: lossless round-trip
