// NvS OS environment — pure NvS over real builtins.
// (Wave 20: rewritten from the ffi::call stub.)
module std.os.env;

pub fn get(key: string) -> string {
    return env(key);
}

pub fn get_or(key: string, fallback: string) -> string {
    return env(key, fallback);
}

pub fn set(key: string, value: string) {
    set_env(key, value);
}

pub fn all() {
    return env_all();
}
