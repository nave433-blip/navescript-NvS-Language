// NvS DateTime module — pure NvS over real builtins.
// (Wave 20: rewritten from the ffi::call stub.)
//
// Note: the builtin sleep(ms) is the sleep API — no wrapper is defined here
// because a fn named `sleep` would shadow the builtin and recurse forever.
module std.datetime.time;

pub class Time {
    pub let unixMillis: number;

    pub fn init() {
        this.unixMillis = unixtime_ms();
    }

    pub fn fromMillis(ms: number) {
        this.unixMillis = ms;
    }

    fn unixSeconds() -> number {
        return int(this.unixMillis / 1000);
    }

    pub fn format(pattern: string) -> string {
        return date_format(this.unixSeconds(), pattern);
    }

    pub fn iso() -> string {
        return date_format(this.unixSeconds(), "2006-01-02T15:04:05Z07:00");
    }

    pub fn add(millis: number) -> Time {
        let t = new Time();
        t.fromMillis(this.unixMillis + millis);
        return t;
    }

    pub fn sub(other: Time) -> number {
        return this.unixMillis - other.unixMillis;
    }
}
