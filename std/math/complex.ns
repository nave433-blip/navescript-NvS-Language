// NvS complex math — pure NvS.
// (Wave 20: rewritten from the ffi::call stub.)
module std.math.complex;

pub class Complex {
    pub let real: number;
    pub let imag: number;

    pub fn init(real: number, imag: number) {
        this.real = real;
        this.imag = imag;
    }

    pub fn add(other: Complex) -> Complex {
        return new Complex(this.real + other.real, this.imag + other.imag);
    }

    pub fn sub(other: Complex) -> Complex {
        return new Complex(this.real - other.real, this.imag - other.imag);
    }

    pub fn mul(other: Complex) -> Complex {
        let r = this.real * other.real - this.imag * other.imag;
        let i = this.real * other.imag + this.imag * other.real;
        return new Complex(r, i);
    }

    pub fn div(other: Complex) -> Complex {
        let d = other.real * other.real + other.imag * other.imag;
        if (d == 0) {
            throw "Complex division by zero";
        }
        let r = (this.real * other.real + this.imag * other.imag) / d;
        let i = (this.imag * other.real - this.real * other.imag) / d;
        return new Complex(r, i);
    }

    pub fn abs() -> number {
        return sqrt(this.real * this.real + this.imag * this.imag);
    }

    pub fn conj() -> Complex {
        return new Complex(this.real, 0 - this.imag);
    }
}
