// NvS cryptography — pure NvS over real builtins.
// (Wave 20: rewritten from the ffi::call stub.)
//
// Hashing: sha256/sha1/md5 builtins (md5/sha1 are fingerprinting hashes,
// NOT security primitives). HMAC: hmac_sha256(key, message).
// Symmetric encryption is AES-256-GCM via aes_gcm_encrypt/decrypt;
// keys must be 16, 24, or 32 bytes.
module std.crypto;

pub class Sha256 {
    pub static fn hash(data: string) -> string {
        return sha256(data);
    }
}

pub class Aes {
    pub static fn encrypt(data: string, key: string) -> string {
        return aes_gcm_encrypt(key, data);
    }

    pub static fn decrypt(data: string, key: string) -> string {
        return aes_gcm_decrypt(key, data);
    }
}

pub class Ed25519 {
    pub static fn generate() {
        return ed25519_generate();
    }

    pub static fn sign(data: string, private_key: string) -> string {
        return ed25519_sign(private_key, data);
    }

    pub static fn verify(data: string, signature: string, public_key: string) -> bool {
        return ed25519_verify(public_key, data, signature);
    }
}
