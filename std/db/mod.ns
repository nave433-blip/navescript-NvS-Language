// NvS document database — pure NvS, file-backed JSON.
// (Wave 20: rewritten from the ffi::call stub.)
//
// Honest design: each Database is one JSON file on disk (collections are
// top-level keys). Reads load the file at open; every mutation writes it
// back, so data survives the process. This is a document store, not a
// relational database — for in-memory SQL tables, see the sqlite_*
// builtins (in-memory SQL subset, no persistence, documented in
// LANGUAGE.md).
module std.db;

pub class Database {
    let path: string;
    let data: any;

    pub static fn open(path: string) -> Database {
        let db = new Database();
        db.path = path;
        if (exists(path)) {
            db.data = json_parse(read_file(path));
        } else {
            db.data = {};
        }
        return db;
    }

    fn save() {
        write_file(this.path, json_stringify(this.data));
    }

    pub fn put(collection: string, key: string, doc: any) {
        if (!has(this.data, collection)) {
            this.data[collection] = {};
        }
        this.data[collection][key] = doc;
        this.save();
    }

    pub fn get(collection: string, key: string) -> any {
        if (has(this.data, collection) && has(this.data[collection], key)) {
            return this.data[collection][key];
        }
        return null;
    }

    pub fn delete(collection: string, key: string) {
        if (has(this.data, collection)) {
            delete(this.data[collection], key);
            this.save();
        }
    }

    fn matches(doc: any, filter) -> bool {
        for (k in keys(filter)) {
            if (!has(doc, k) || doc[k] != filter[k]) {
                return false;
            }
        }
        return true;
    }

    pub fn query(collection: string, filter) -> any[] {
        let out = [];
        if (!has(this.data, collection)) {
            return out;
        }
        for (k in keys(this.data[collection])) {
            let doc = this.data[collection][k];
            if (this.matches(doc, filter)) {
                out = push(out, doc);
            }
        }
        return out;
    }

    pub fn close() {
        this.save();
    }
}
