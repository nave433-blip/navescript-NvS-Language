// NvS TCP networking — pure NvS over the tcp_* builtins.
// (Wave 20: rewritten from the ffi::call stub. The builtins are backed
// by Go's net package — real sockets, no native layer needed.)
module std.net.tcp;

pub class TcpStream {
    let handle: string;

    pub static fn connect(address: string, port: number) -> TcpStream {
        let stream = new TcpStream();
        stream.handle = tcp_connect(address, port);
        return stream;
    }

    pub fn write(data: string) -> number {
        return tcp_write(this.handle, data);
    }

    pub fn read(n: number) -> string {
        return tcp_read(this.handle, n);
    }

    pub fn close() {
        tcp_close(this.handle);
    }
}

pub class TcpListener {
    let handle: string;

    pub static fn bind(port: number) -> TcpListener {
        let listener = new TcpListener();
        listener.handle = tcp_listen(port);
        return listener;
    }

    pub fn accept() -> TcpStream {
        let stream = new TcpStream();
        stream.handle = tcp_accept(this.handle);
        return stream;
    }

    pub fn close() {
        tcp_close(this.handle);
    }
}
